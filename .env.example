# App
DEBUG=false
STAT=true
MAGIC_ERASARR_PORT=5000

# Tautulli
TAUTULLI_URL=http://localhost:8181
TAUTULLI_API_KEY=your_tautulli_api_key

# Plex Media Server (optional — refresh library after Radarr deletes files)
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token

# Seerr (Overseerr-compatible)
OVERSEERR_URL=http://localhost:5055
OVERSEERR_API_KEY=your_seerr_api_key

# Radarr (primary)
RADARR_1_URL=http://localhost:7878
RADARR_1_API_KEY=your_radarr_api_key
RADARR_1_NAME=Radarr

# Radarr (secondary — leave blank to disable)
RADARR_2_URL=
RADARR_2_API_KEY=
RADARR_2_NAME=Radarr 4K

# Sonarr (primary)
SONARR_1_URL=http://localhost:8989
SONARR_1_API_KEY=your_sonarr_api_key
SONARR_1_NAME=Sonarr

# Sonarr (secondary — leave blank to disable)
SONARR_2_URL=
SONARR_2_API_KEY=
SONARR_2_NAME=Sonarr 4K

# Lidarr (primary)
LIDARR_1_URL=http://localhost:8686
LIDARR_1_API_KEY=your_lidarr_api_key
LIDARR_1_NAME=Lidarr

# Lidarr (secondary — leave blank to disable)
LIDARR_2_URL=
LIDARR_2_API_KEY=
LIDARR_2_NAME=Lidarr 4K
